# Gmail：smtp.gmail.com:587，SMTP_SSL=0，SMTP_TLS=1。密码用应用专用密码，不是登录密码。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=0
SMTP_TLS=1
