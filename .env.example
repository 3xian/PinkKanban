# 本地开发默认值。生产环境必须更换密码和密钥。
DATABASE_URL=mysql+pymysql://kanban:kanban@127.0.0.1:3307/kanban?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-string
APP_TIMEZONE=Asia/Shanghai
DAILY_PROJECT_LIMIT=30
